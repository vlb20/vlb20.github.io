{
  "name": {{ site.title | jsonify }},
  "short_name": "VLB",
  "description": {{ site.description | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "lang": "en",
  "background_color": "#F7F6F2",
  "theme_color": "#0B0B0C",
  "icons": [
    { "src": "{{ '/images/favicon-192x192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/images/favicon-512x512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
